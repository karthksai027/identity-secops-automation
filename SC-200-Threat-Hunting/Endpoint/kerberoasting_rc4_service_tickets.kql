// =====================================================================================
// Title       : Kerberoasting - burst of RC4 service ticket requests from one account
// Author      : Karthik (github.com/karthksai027) - Karthik's Identity & SecOps Toolkit
// MITRE ATT&CK: T1558.003 Steal or Forge Kerberos Tickets: Kerberoasting
// Data source : SecurityEvent (domain controllers, Event ID 4769) via Azure Monitor Agent
//               with "Common" or "All Events" collection. Microsoft Defender for Identity also
//               detects this natively.
// Description : Kerberoasting requests service tickets for accounts with SPNs and cracks them
//               offline. Tools usually request RC4 (0x17) tickets for many services at once.
//               Pair with Identity-Security-Posture/Get-ADSecurityPostureSummary.ps1, which lists
//               the Kerberoastable accounts that would be exposed.
// Tuning      : Legacy apps may legitimately use RC4; baseline them and exclude.
// =====================================================================================
let Lookback = 1d;
let MinServices = 5;
SecurityEvent
| where TimeGenerated > ago(Lookback)
| where EventID == 4769
| where TicketEncryptionType == "0x17"          // RC4-HMAC
| where Status == "0x0"                         // ticket issued
| where ServiceName !endswith "$" and ServiceName !~ "krbtgt"
| where TargetUserName !endswith "$"            // ignore computer accounts
| summarize
    DistinctServices = dcount(ServiceName),
    Services = make_set(ServiceName, 50),
    Requests = count(),
    FirstSeen = min(TimeGenerated),
    LastSeen = max(TimeGenerated),
    DomainControllers = make_set(Computer, 5)
    by RequestingAccount = TargetUserName, ClientIP = IpAddress, Window = bin(TimeGenerated, 1h)
| where DistinctServices >= MinServices
| order by DistinctServices desc
