// =====================================================================================
// Title       : On-premises AD brute force and account lockouts
// Author      : Karthik (github.com/karthksai027) - Karthik's Identity & SecOps Toolkit
// MITRE ATT&CK: T1110 Brute Force
// Data source : SecurityEvent (Event IDs 4625 failed logon, 4740 account locked out)
// Description : Summarises failed logons by source and target, separating single-account
//               brute force (many failures, one account) from spraying (few failures, many
//               accounts), and joins lockout events to show impact.
// Tuning      : Exclude vulnerability scanners and monitoring service accounts.
// =====================================================================================
let Lookback = 1d;
let MinFailures = 20;
let Lockouts = SecurityEvent
    | where TimeGenerated > ago(Lookback)
    | where EventID == 4740
    | summarize LockedAccounts = make_set(TargetUserName, 50), LockoutCount = count() by CallerComputer = TargetDomainName;
SecurityEvent
| where TimeGenerated > ago(Lookback)
| where EventID == 4625
| extend SourceIP = iff(IpAddress in ("-", "", "::1", "127.0.0.1"), "local", IpAddress)
| summarize
    Failures = count(),
    DistinctAccounts = dcount(TargetAccount),
    Accounts = make_set(TargetAccount, 25),
    FailureReasons = make_set(SubStatus, 10),      // 0xC000006A bad password, 0xC0000064 no such user, 0xC0000234 locked
    LogonTypes = make_set(LogonType, 5),
    Targets = make_set(Computer, 10),
    FirstSeen = min(TimeGenerated),
    LastSeen = max(TimeGenerated)
    by SourceIP, WorkstationName
| where Failures >= MinFailures
| extend Pattern = iff(DistinctAccounts >= 10, "Password spray", "Brute force")
| join kind=leftouter Lockouts on $left.WorkstationName == $right.CallerComputer
| project-away CallerComputer
| order by Failures desc
