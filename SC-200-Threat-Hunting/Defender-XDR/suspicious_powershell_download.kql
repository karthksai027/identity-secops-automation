// =====================================================================================
// Title       : PowerShell downloading or running code from the internet
// Author      : Karthik (github.com/karthksai027) - Karthik's Identity & SecOps Toolkit
// MITRE ATT&CK: T1059.001 Command and Scripting Interpreter: PowerShell; T1105 Ingress Tool Transfer
// Data source : Microsoft Defender XDR advanced hunting - DeviceProcessEvents (Defender for Endpoint)
// Description : Most commodity malware and hands-on-keyboard attacks use PowerShell to pull a payload
//               from the internet (a "download cradle") or hide what it runs with an encoded command.
//               This finds PowerShell launched with those patterns, and shows which process started it,
//               because Office apps or browsers launching PowerShell is a strong signal.
// Tuning      : Exclude known management tools (Intune, SCCM, RMM agents) by InitiatingProcessFileName
//               or by a known script path once you've baselined your environment.
// Response    : Isolate the device from the Defender portal if the parent is Office, a browser or wscript.
// Run it      : Defender portal > Hunting > Advanced hunting, or Defender-XDR\Invoke-DefenderAdvancedHunting.ps1
// =====================================================================================
let Lookback = 7d;
let CradlePatterns = dynamic(["DownloadString", "DownloadFile", "DownloadData", "Invoke-WebRequest", "iwr", "Invoke-RestMethod",
                              "irm", "Net.WebClient", "Start-BitsTransfer", "FromBase64String", "IEX", "Invoke-Expression"]);
let SuspiciousParents = dynamic(["winword.exe", "excel.exe", "powerpnt.exe", "outlook.exe", "msedge.exe", "chrome.exe",
                                 "firefox.exe", "wscript.exe", "cscript.exe", "mshta.exe"]);
DeviceProcessEvents
| where Timestamp > ago(Lookback)
| where FileName in~ ("powershell.exe", "pwsh.exe", "powershell_ise.exe")
| where ProcessCommandLine has_any (CradlePatterns)
    or ProcessCommandLine matches regex @"(?i)\s-e(nc|ncodedcommand)?\s+[A-Za-z0-9+/=]{20,}"
| extend SuspiciousParent = InitiatingProcessFileName in~ (SuspiciousParents)
| extend Encoded = ProcessCommandLine matches regex @"(?i)\s-e(nc|ncodedcommand)?\s+[A-Za-z0-9+/=]{20,}"
| project Timestamp, DeviceName, AccountName, InitiatingProcessFileName, SuspiciousParent, Encoded,
          ProcessCommandLine, InitiatingProcessCommandLine, DeviceId, ReportId
| order by SuspiciousParent desc, Timestamp desc
