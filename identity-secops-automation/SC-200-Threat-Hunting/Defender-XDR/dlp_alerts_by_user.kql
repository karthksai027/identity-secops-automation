// =====================================================================================
// Title       : Data loss prevention alerts by user, workload and policy
// Author      : Karthik (github.com/karthksai027) - Karthik's Identity & SecOps Toolkit
// MITRE ATT&CK: T1567 Exfiltration Over Web Service; T1048 Exfiltration Over Alternative Protocol
// Data source : Microsoft Defender XDR advanced hunting - AlertInfo, AlertEvidence (Microsoft Purview DLP alerts)
// Description : Purview DLP alerts flow into Defender XDR. One alert is usually a mistake; the same
//               person tripping DLP again and again, across email, SharePoint and endpoint, is worth a
//               conversation or an insider risk review. This rolls DLP alerts up per user.
// Tuning      : Raise MinAlerts for large tenants. Pair with Purview-DLP\Get-PurviewDlpPolicyReport.ps1
//               to see which policies are still in test mode and therefore not alerting.
// =====================================================================================
let Lookback = 30d;
let MinAlerts = 3;
let DlpAlerts = AlertInfo
    | where Timestamp > ago(Lookback)
    | where ServiceSource == "Microsoft Data Loss Prevention" or DetectionSource has "Data Loss Prevention"
    | project AlertId, AlertTime = Timestamp, AlertTitle = Title, AlertSeverity = Severity;
AlertEvidence
| where Timestamp > ago(Lookback)
| where EntityType == "User" and isnotempty(AccountUpn)
| join kind=inner DlpAlerts on AlertId
| summarize
    Alerts = dcount(AlertId),
    HighSeverity = dcountif(AlertId, AlertSeverity == "High"),
    Policies = make_set(AlertTitle, 20),
    FirstAlert = min(AlertTime),
    LastAlert = max(AlertTime)
    by AccountUpn
| where Alerts >= MinAlerts
| order by HighSeverity desc, Alerts desc
