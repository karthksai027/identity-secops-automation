// =====================================================================================
// Title       : Users who clicked a link in an email that was flagged as phishing or malware
// Author      : Karthik (github.com/karthksai027) - Karthik's Identity & SecOps Toolkit
// MITRE ATT&CK: T1566.002 Phishing: Spearphishing Link; T1204.001 User Execution: Malicious Link
// Data source : Microsoft Defender XDR advanced hunting - EmailEvents, UrlClickEvents (Defender for Office 365)
// Description : Defender for Office 365 sometimes delivers a message and only flags it later (or the
//               user clicks through a Safe Links warning). This joins delivered phishing/malware email
//               with Safe Links click data to show who actually clicked, so you know whose password to
//               reset and whose sessions to revoke first.
// Tuning      : Add ThreatTypes "Spam" if you want the wider list.
// Response    : For IsClickedThrough = true, reset the password, revoke sessions and check sign-ins
//               (M365-Security-Operations\Invoke-CompromisedAccountResponse.ps1).
// =====================================================================================
let Lookback = 7d;
let ThreatMail = EmailEvents
    | where Timestamp > ago(Lookback)
    | where EmailDirection == "Inbound"
    | where ThreatTypes has_any ("Phish", "Malware")
    | project NetworkMessageId, MailTime = Timestamp, SenderFromAddress, RecipientEmailAddress, Subject,
              MailThreatTypes = ThreatTypes, DeliveryAction, DeliveryLocation;
UrlClickEvents
| where Timestamp > ago(Lookback)
| where Workload == "Email"
| join kind=inner ThreatMail on NetworkMessageId
| project ClickTime = Timestamp, AccountUpn, ActionType, IsClickedThrough, Url, IPAddress,
          SenderFromAddress, Subject, MailThreatTypes, DeliveryAction, DeliveryLocation, MailTime
| order by IsClickedThrough desc, ClickTime desc
