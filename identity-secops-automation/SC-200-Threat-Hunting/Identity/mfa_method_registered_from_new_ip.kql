// =====================================================================================
// Title       : MFA / security info registered from an IP the user has never signed in from
// Author      : Karthik (github.com/karthksai027) - Karthik's Identity & SecOps Toolkit
// MITRE ATT&CK: T1098.005 Account Manipulation: Device Registration
// Data source : AuditLogs, SigninLogs
// Description : After phishing a session, attackers register their own authenticator or phone
//               so they keep access after a password reset. This query flags security info
//               registrations whose source IP does not appear in the user's successful sign-ins
//               from the previous 14 days.
// Response    : Delete the unknown method, revoke sessions, investigate the account.
// =====================================================================================
let DetectionWindow = 7d;
let BaselineWindow = 14d;
let Registrations = AuditLogs
    | where TimeGenerated > ago(DetectionWindow)
    | where OperationName in ("User registered security info", "User registered all required security info",
                              "Admin registered security info", "User changed default security info")
    | extend UserPrincipalName = tostring(TargetResources[0].userPrincipalName)
    | extend RegistrationIP = tostring(InitiatedBy.user.ipAddress)
    | extend Initiator = tostring(InitiatedBy.user.userPrincipalName)
    | project RegistrationTime = TimeGenerated, OperationName, UserPrincipalName, Initiator, RegistrationIP, ResultDescription;
let KnownIPs = SigninLogs
    | where TimeGenerated between (ago(DetectionWindow + BaselineWindow) .. ago(DetectionWindow))
    | where ResultType == "0"
    | summarize KnownIPs = make_set(IPAddress, 200) by UserPrincipalName;
Registrations
| join kind=leftouter KnownIPs on UserPrincipalName
| extend KnownIPs = coalesce(KnownIPs, dynamic([]))
| where isnotempty(RegistrationIP) and not(set_has_element(KnownIPs, RegistrationIP))
| project RegistrationTime, UserPrincipalName, OperationName, ResultDescription, RegistrationIP, Initiator,
          KnownIPCount = array_length(KnownIPs)
| order by RegistrationTime desc
