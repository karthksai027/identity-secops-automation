// =====================================================================================
// Title       : Password spray - one IP failing against many accounts
// Author      : Karthik (github.com/karthksai027) - Karthik's Identity & SecOps Toolkit
// MITRE ATT&CK: T1110.003 Brute Force: Password Spraying
// Data source : Microsoft Sentinel / Log Analytics - SigninLogs (Entra ID diagnostic settings)
// Description : Password spraying tries one or two common passwords against many accounts
//               to stay under lockout thresholds. This query finds source IPs with failed
//               password sign-ins against many distinct accounts, then checks whether any
//               account had a SUCCESSFUL sign-in from the same IP (likely compromise).
// Tuning      : Raise MinDistinctAccounts for large tenants; exclude known NAT / proxy egress IPs.
// Response    : Block the IP with a Named Location + Conditional Access, reset passwords and
//               revoke sessions for any account in SuccessfulAccounts.
// =====================================================================================
let Lookback = 1d;
let MinDistinctAccounts = 10;
let ExcludedIPs = dynamic([]);   // e.g. dynamic(["203.0.113.10"])
// 50126 invalid username/password, 50053 locked (smart lockout), 50055 expired password, 50057 disabled account
let FailureCodes = dynamic(["50126", "50053", "50055", "50057"]);
let Failures = SigninLogs
    | where TimeGenerated > ago(Lookback)
    | where ResultType in (FailureCodes)
    | where IPAddress !in (ExcludedIPs)
    | summarize
        FailedAccounts = dcount(UserPrincipalName),
        FailedAttempts = count(),
        SampleAccounts = make_set(UserPrincipalName, 25),
        Apps = make_set(AppDisplayName, 10),
        UserAgents = make_set(UserAgent, 5),
        FirstSeen = min(TimeGenerated),
        LastSeen = max(TimeGenerated)
        by IPAddress, Country = tostring(LocationDetails.countryOrRegion)
    | where FailedAccounts >= MinDistinctAccounts;
let Successes = SigninLogs
    | where TimeGenerated > ago(Lookback)
    | where ResultType == "0"
    | summarize SuccessfulAccounts = make_set(UserPrincipalName, 25) by IPAddress;
Failures
| join kind=leftouter Successes on IPAddress
| project-away IPAddress1
| extend SuccessfulAccounts = coalesce(SuccessfulAccounts, dynamic([]))
| extend LikelyCompromise = array_length(SuccessfulAccounts) > 0
| order by LikelyCompromise desc, FailedAccounts desc
