// =====================================================================================
// Title       : Legacy (basic) authentication sign-ins
// MITRE ATT&CK: T1078.004 Valid Accounts: Cloud Accounts (MFA bypass via legacy protocols)
// Data source : SigninLogs
// Description : Legacy protocols (IMAP, POP3, SMTP AUTH, ActiveSync basic, older Office clients)
//               cannot perform MFA, so they are the main target of password spray. Use this
//               to find who still depends on them before (or after) a "Block legacy
//               authentication" Conditional Access policy, and to spot attacks against them.
// Response    : Move remaining users/devices to modern auth, then enforce the CA block.
//               Successful legacy sign-ins from unfamiliar IPs = investigate immediately.
// =====================================================================================
let Lookback = 7d;
let LegacyClients = dynamic([
    "Authenticated SMTP", "AutoDiscover", "Exchange ActiveSync", "Exchange Online PowerShell",
    "Exchange Web Services", "IMAP4", "MAPI Over HTTP", "Offline Address Book", "Other clients",
    "Outlook Anywhere (RPC over HTTP)", "POP3", "Reporting Web Services", "Outlook Service"
]);
SigninLogs
| where TimeGenerated > ago(Lookback)
| where ClientAppUsed in (LegacyClients)
| extend Outcome = iff(ResultType == "0", "Success", "Failure")
| summarize
    Attempts = count(),
    Successes = countif(Outcome == "Success"),
    Failures = countif(Outcome == "Failure"),
    IPs = make_set(IPAddress, 10),
    Countries = make_set(tostring(LocationDetails.countryOrRegion), 10),
    LastSeen = max(TimeGenerated)
    by UserPrincipalName, ClientAppUsed, ConditionalAccessStatus
| order by Successes desc, Attempts desc
